{% set classes = [
  'paragraph',
  'mb-3',
  'paragraph--type--' ~ paragraph.bundle|clean_class,
  view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
  not paragraph.isPublished() ? 'paragraph--unpublished'
] %}

{% block paragraph %}
  <div{{ attributes.addClass(classes) }}>

    <style>
  .slide-img-clip {
  clip-path: polygon(7.5% 0, 100% 0, 100% 100%, 0 100%);
  
  object-fit: cover;  /* keep aspect ratio, crop if needed */
}

@media (min-width: 1600px) {
  .slide-img-clip {
   
  }
}

.carousel {
  padding-left: 0vw;
  padding-right: 0vw;
}

/* UPDATED: Use min-height and flex layout for carousel items */
.carousel-item {
  
  display: flex;      /* make carousel-item a flex container */
  align-items: stretch; /* stretch children vertically */
}

/* Remove Bootstrap row margins and make row take full width and height */
.carousel-item .row {
  flex-grow: 1;
  margin: 0;
  width: 100%;
}

/* Remove padding from columns, make columns flex containers for vertical alignment */
.carousel-item .col-md-3,
.carousel-item .col-md-9 {
  padding: 0;
  display: flex;
  align-items: center;
}

/* Make image fill the height of col-md-9 and cover */
.col-md-9 img.slide-img-clip {
  height: 100%;
  width: 100%;
  object-fit: cover;
}

@media (max-width: 575px) {
  .carousel-item {
    position: relative;
    height: auto;
    display: block;  /* revert flex for small screens */
  }

  .carousel-item .row,
  .carousel-item .col-md-3,
  .carousel-item .col-md-9 {
    padding: initial;
    display: block;
  }

  .col-md-9 img.slide-img-clip {
    height: auto;
  }

  .carousel-control-prev,
  .carousel-control-next {
    display: none;
  }

  .slide-img-clip {
    clip-path: none;
  }
}

.carousel-control-prev-icon,
.carousel-control-next-icon {
  filter: invert(1);
  transform: scale(1);
}

.carousel-control-prev,
.carousel-control-next {
  background-color: transparent;
  opacity: 0.7;
  margin: 0 -2.5rem;
  width: 2.5vw;
}

.caption-text {
  font-size: 1.15rem;
  text-align: justify;
  padding-right: 1rem;
}
.carousel-item .card {
  border: 1px solid #ddd; /* Light border for the card */
  border-radius: 0.5rem; /* Rounded corners */
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Subtle shadow */
  overflow: hidden; /* Ensure content stays within the card */
}

.carousel-item .card img {
  border-bottom: 1px solid #ddd; /* Separate image from content */
  border-radius: 0; /* Remove image border radius */
}

.carousel-item .card-body {
  padding: 1rem; /* Add padding inside the card */
  text-align: center; /* Center-align text */
}

.carousel-item .card-title {
  font-size: 1.25rem; /* Slightly larger title */
  font-weight: bold;
  margin-bottom: 0.5rem;
}

.carousel-item .card-text {
  font-size: 1rem;
  color: #666; /* Subtle text color */
}

    </style>

    {% set carousel_id = 'carousel--' ~ paragraph.id() %}
    {% set items = paragraph.field_carousel_items %}

    {% if items|length > 0 %}
      <div class="container my-2 p-0">
      

{{ attach_library('fire_and_safety/main') }}


<div{{ attributes.addClass(classes) }}>
  {% block content %}
    {% set accordion_items = [] %}
    {% set target_ids = [] %}

    {# Build accordion items and target IDs safely #}
    {% for item in other_page_items %}
      {% if item.title not in ['Introduction', 'Organization Structure', 'Events'] %}
        {% set accordion_item = {
          'title': item.title,
          'title_tag': 'h4',
          'content': item.content,
          'stay_open': false
        } %}
        {% set accordion_items = (accordion_items is iterable ? accordion_items : []) | merge([accordion_item]) %}
        {% set target_id = 'collapse-accordion--' ~ accordion_paragraph.id() ~ '-' ~ loop.index0 %}
        {% set target_ids = (target_ids is iterable ? target_ids : []) | merge([target_id]) %}
      {% endif %}
    {% endfor %}

    {# Render menu if there are items #}
    {% if accordion_items is iterable and accordion_items|length > 0 %}
      <div class="accordion-submenu-wrapper mb-4" id="accordion-menu-{{ accordion_paragraph.id() }}">
        <nav class="accordion-submenu card">
          <div class="my-list row g-2">
            {% for item in accordion_items|reverse %}
              {% set index = loop.index0 %}
              {% set target_id = target_ids[index] %}
              {% if item.title != 'Planner' %}
                <div class="col-md-3">
                  <a href="#{{ target_id }}" 
                     class="list-group-item list-group-item-action" 
                     {{ loop.first ? 'aria-current="true"' : '' }}>
                    {{ item.title }}
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </nav>
      </div>

    
    {% endif %}
  {% endblock %}
</div>

        <div id="{{ carousel_id }}" class="carousel slide" data-bs-ride="carousel">

          <!-- Carousel Items -->
          <div class="carousel-inner">
            {% for item in items %}
              {% set media = item.entity.field_image.entity %}
              {% set image_uri = media.field_media_image|file_url %}
              {% set caption = item.entity.field_caption.value %}
             {% set title = item.entity.field_title.value %}

              {% set link = item.entity.field_link.uri ?? '#' %}

              <div class="carousel-item{{ loop.first ? ' active' }}">
                <div class="row">
                  <div class="col-md-3 d-flex flex-column justify-content-start align-items-start ">
                    {% if caption %}
                    <div class="fs-4"><strong>{{title}}</strong></div>
                      <div class="fs-6">{{ caption }}</div>
                    {% endif %}
                  </div>
                  <div class="col-md-9">
                    <a href="{{ link }}" class="d-block w-100">
                      <img class="slide-img-clip img-fluid w-100 h-100"
                         src="{{ image_uri }}"
                         alt="{{ media.field_media_image.alt ?? '' }}">
                    </a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>

          <!-- Controls -->
          <button class="carousel-control-prev" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#{{ carousel_id }}" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>
      </div>
    {% endif %}

    {{ content|without('field_carousel_items') }}
  </div>
  
{% endblock paragraph %}
